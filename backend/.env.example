# App Settings
APP_NAME="K.K. Wagh Polytechnic AI Chatbot API"
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL or SQLite fallback)
# For PostgreSQL: postgresql://user:password@localhost:5432/kkwagh_db
# Default local fallback: sqlite:///./kkwagh.db
DATABASE_URL=sqlite:///./kkwagh.db

# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Vector DB
CHROMA_PERSIST_DIR=./chroma_db

# Security & JWT
JWT_SECRET_KEY=change_this_super_secret_jwt_key_for_kk_wagh_polytechnic_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Defaults & Secret Key
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@kkwagh.edu.in
DEFAULT_ADMIN_PASSWORD=Admin@KKWagh2026
ADMIN_REGISTRATION_SECRET=kkwagh_admin_reg_secret_2026

# CORS Allowed Origins (Comma separated - NO WILDCARDS in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
